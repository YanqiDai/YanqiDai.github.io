{% assign blogs = page.blogs %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="{{ profile.description | escape }}" />
  <title>{{ profile.name | escape }}'s Homepage</title>

  <!-- Theme color follows the dark/light surface -->
  <meta name="theme-color" content="#03070b" media="(prefers-color-scheme: dark)" />
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />

  <!-- Inline SVG favicon: the "YD" brand mark, no extra request -->
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='16' fill='%23356f9d'/%3E%3Ctext x='32' y='44' font-family='monospace' font-size='30' font-weight='700' text-anchor='middle' fill='%23ffffff'%3EYD%3C/text%3E%3C/svg%3E" />

  <!-- Open Graph / Twitter share cards -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content="{{ profile.name | escape }}'s Homepage" />
  <meta property="og:description" content="{{ profile.description | escape }}" />
  <meta property="og:url" content="{{ profile.site_url | escape }}/" />
  <meta property="og:image" content="{{ profile.site_url | escape }}/{{ profile.image | escape }}" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ profile.name | escape }}'s Homepage" />
  <meta name="twitter:description" content="{{ profile.description | escape }}" />
  <meta name="twitter:image" content="{{ profile.site_url | escape }}/{{ profile.image | escape }}" />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  <script>
    // First visit defaults to dark; later visits use the saved user choice.
    (function () {
      try {
        var saved = localStorage.getItem('theme');
        var theme = saved === 'light' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', theme);
      } catch (e) {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
    })();
  </script>
  <style>
    :root {
      --bg: #03070b;
      --bg-2: #071522;
      --card: #0a1928;
      --card-strong: #10263b;
      --text: #f7fbff;
      --muted: #a8b9ca;
      --muted-2: #758ba1;
      --line: #203b55;
      --accent: #78add8;
      --accent-surface: #123554;
      --accent-surface-strong: #19476f;
      --on-accent: #03070b;
      --shadow: 0 12px 34px rgba(0, 0, 0, 0.28);
      --radius-xl: 32px;
      --radius-lg: 24px;
      --radius-md: 18px;
      --max: 1180px;

      /* unified type scale by content role */
      --type-display: clamp(44px, 7vw, 96px);
      --type-section-title: clamp(30px, 4vw, 52px);
      --type-card-title: clamp(18px, 1.55vw, 20px);
      --type-lead: clamp(16px, 1.5vw, 20px);
      --type-body: 16px;
      --type-secondary: 14px;
      --type-meta: 13px;
      --type-label: 12px;

      /* photographic background */
      --bg-shift-x: 0px;
      --bg-shift-y: 0px;
      --photo-opacity: 0.28;
      --photo-veil: rgba(3, 7, 11, 0.58);

      /* themeable surfaces */
      --nav-bg: #050d15;
      --menu-bg: #050d15;
      --orbit-line: #294963;
    }

    html[data-theme="light"] {
      --bg: #ffffff;
      --bg-2: #f4f9fd;
      --card: #ffffff;
      --card-strong: #eaf4fb;
      --text: #10283d;
      --muted: #4b667d;
      --muted-2: #61798f;
      --line: #c9dfef;
      --accent: #356f9d;
      --accent-surface: #e4f2fb;
      --accent-surface-strong: #cfe7f7;
      --on-accent: #ffffff;
      --shadow: 0 12px 30px rgba(30, 80, 120, 0.10);

      --photo-opacity: 0.20;
      --photo-veil: rgba(255, 255, 255, 0.66);

      --nav-bg: #ffffff;
      --menu-bg: #ffffff;
      --orbit-line: #bdd7e9;
    }

    * { box-sizing: border-box; }

    :focus-visible {
      outline: 3px solid var(--accent);
      outline-offset: 3px;
    }

    html {
      scroll-behavior: smooth;
      background: var(--bg);
    }

    body {
      margin: 0;
      font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      font-size: var(--type-body);
      line-height: 1.6;
      color: var(--text);
      background: var(--bg);
      min-height: 100vh;
      overflow-x: hidden;
      isolation: isolate;
      transition: color 0.3s ease, background-color 0.3s ease;
    }

    .background-photo,
    .background-veil {
      position: fixed;
      pointer-events: none;
    }

    .background-photo {
      inset: -30px;
      z-index: -7;
      opacity: var(--photo-opacity);
      transform: translate3d(var(--bg-shift-x), var(--bg-shift-y), 0) scale(1.055);
      transform-origin: center;
      will-change: transform;
      transition: opacity .35s ease;
    }

    .background-photo img {
      display: block;
      width: 100%;
      height: 100%;
    }

    .background-photo img {
      object-fit: cover;
      object-position: center 48%;
    }

    .background-veil {
      inset: 0;
      z-index: -6;
      background: var(--photo-veil);
      transition: background .35s ease;
    }

    .progress {
      position: fixed;
      top: 0;
      left: 0;
      height: 3px;
      width: 0%;
      z-index: 1000;
      background: var(--accent);
    }

    .container {
      width: min(var(--max), calc(100% - 38px));
      margin: 0 auto;
    }

    .nav-wrap {
      position: sticky;
      top: 16px;
      z-index: 100;
      margin-top: 16px;
    }

    nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 13px 14px 13px 18px;
      border: 1px solid var(--line);
      border-radius: 999px;
      background: var(--nav-bg);
      box-shadow: var(--shadow);
    }

    .brand {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      color: var(--text);
      font-size: var(--type-body);
      line-height: 1.2;
      font-weight: 900;
      letter-spacing: -0.04em;
    }

    .brand-mark {
      width: 34px;
      height: 34px;
      border-radius: 12px;
      display: grid;
      place-items: center;
      font-family: "JetBrains Mono", monospace;
      font-size: var(--type-secondary);
      line-height: 1;
      font-weight: 800;
      color: var(--on-accent);
      background: var(--accent);
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 4px;
      flex-wrap: wrap;
      flex: 1;
      justify-content: flex-end;
    }

    .nav-links a {
      color: var(--muted);
      text-decoration: none;
      font-size: calc(var(--type-body) - 1px);
      line-height: 1.2;
      font-weight: 700;
      padding: 10px 13px;
      border-radius: 999px;
      border: 0;
      background: transparent;
      cursor: pointer;
      transition: 0.2s ease;
    }

    .nav-links a:hover {
      color: var(--text);
      background: var(--card-strong);
    }

    .nav-links a.active {
      color: var(--text);
      background: var(--card-strong);
    }

    .nav-toggle {
      display: none;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      width: 44px;
      height: 44px;
      padding: 0;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: var(--card);
      cursor: pointer;
      transition: 0.2s ease;
    }

    .nav-toggle-bar {
      width: 18px;
      height: 2px;
      margin: 0 auto;
      border-radius: 2px;
      background: var(--text);
      transition: transform 0.25s ease, opacity 0.2s ease;
    }

    .nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }
    .nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(2) {
      opacity: 0;
    }
    .nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }

    .theme-toggle {
      display: inline-grid;
      place-items: center;
      width: 44px;
      height: 44px;
      flex: 0 0 auto;
      padding: 0;
      border: 1px solid var(--line);
      border-radius: 999px;
      background: var(--card);
      color: var(--text);
      cursor: pointer;
      transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease;
    }

    .theme-toggle:hover {
      transform: translateY(-2px);
      border-color: var(--accent);
      background: var(--card-strong);
    }

    .theme-toggle svg {
      width: 19px;
      height: 19px;
    }

    .theme-toggle .icon-moon { display: none; }
    .theme-toggle .icon-sun { display: block; }
    html[data-theme="light"] .theme-toggle .icon-moon { display: block; }
    html[data-theme="light"] .theme-toggle .icon-sun { display: none; }

    .nav-actions {
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .hero {
      min-height: calc(100vh - 80px);
      display: grid;
      grid-template-columns: minmax(0, 1.08fr) minmax(320px, 0.92fr);
      gap: 34px;
      align-items: center;
      padding: 70px 0 44px;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: var(--accent);
      font-family: "JetBrains Mono", monospace;
      font-size: var(--type-label);
      line-height: 1.3;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 10px 14px;
      border-radius: 999px;
      background: var(--accent-surface);
      border: 1px solid var(--accent-surface-strong);
    }

    .pulse {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--accent);
    }

    h1 {
      font-size: var(--type-display);
      line-height: 0.96;
      margin: 22px 0 20px;
      letter-spacing: -0.075em;
      max-width: 880px;
    }

    .hero-name { color: var(--text); }

    .hero-lead {
      color: var(--muted);
      font-size: var(--type-lead);
      line-height: 1.6;
      max-width: 780px;
      margin: 0 0 26px;
    }

    .hero-lead strong { color: var(--text); }

    .cta-row {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 28px;
    }

    .cta-row .btn {
      font-size: var(--type-secondary);
      line-height: 1.2;
      padding: 11px 16px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 13px 18px;
      border-radius: 999px;
      text-decoration: none;
      font-weight: 800;
      border: 1px solid var(--line);
      color: var(--text);
      background: var(--card);
      transition: transform .2s ease, border-color .2s ease, background .2s ease;
    }

    .btn:hover {
      transform: translateY(-3px);
      border-color: var(--accent);
      background: var(--card-strong);
    }

    .btn.primary {
      color: var(--on-accent);
      border-color: transparent;
      background: var(--accent);
    }

    .hero-card {
      position: relative;
      display: grid;
      gap: 12px;
      padding: 18px;
      border-radius: var(--radius-xl);
      background: var(--card);
      border: 1px solid var(--line);
      box-shadow: var(--shadow);
      overflow: hidden;
    }

    .portrait-wrap {
      position: relative;
      overflow: hidden;
      border-radius: 28px;
      aspect-ratio: 1 / 1;
      background: var(--card-strong);
    }

    .portrait-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transform: scale(1.015);
      filter: saturate(1.05) contrast(1.03);
    }

    .status-card {
      position: absolute;
      left: 28px;
      right: 28px;
      bottom: 28px;
      z-index: 2;
      padding: 18px;
      border-radius: 22px;
      border: 1px solid rgba(255,255,255,0.18);
      background: rgba(3, 13, 24, 0.9);
    }

    .status-card h2 {
      margin: 0 0 6px;
      font-size: var(--type-card-title);
      line-height: 1.25;
      letter-spacing: -0.03em;
      color: #f6f8ff;
      overflow-wrap: anywhere;
    }

    .status-card p {
      color: #cbd5f0;
      margin: 0;
      line-height: 1.5;
      font-size: var(--type-secondary);
    }

    .research-chips {
      position: absolute;
      inset: 28px 0 158px;
      z-index: 3;
      pointer-events: none;
      --chip-scale: 1;
    }

    .research-chip {
      position: absolute;
      top: var(--chip-y, 50%);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      max-width: min(190px, 44%);
      min-height: 38px;
      padding: 10px 13px;
      border-radius: 999px;
      background: var(--card-strong);
      border: 1px solid var(--line);
      color: var(--text);
      text-shadow: none;
      font-weight: 800;
      font-size: var(--type-label);
      line-height: 1.25;
      text-align: center;
      overflow-wrap: anywhere;
      pointer-events: auto;
      transform: translateY(-50%) scale(var(--chip-scale));
      transition: transform .2s ease, border-color .2s ease, background .2s ease;
    }

    .research-chip.chip-left {
      left: 0;
      transform-origin: left center;
    }

    .research-chip.chip-right {
      right: 0;
      transform-origin: right center;
    }

    .research-chip:hover {
      border-color: var(--accent);
      background: var(--accent-surface);
    }

    section { padding: 52px 0; }

    main > section {
      content-visibility: auto;
      contain-intrinsic-size: auto 800px;
    }

    .section-head {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 22px;
      margin-bottom: 24px;
    }

    .section-kicker {
      font-family: "JetBrains Mono", monospace;
      color: var(--accent);
      font-size: var(--type-label);
      line-height: 1.3;
      text-transform: uppercase;
      font-weight: 800;
      letter-spacing: 0.14em;
      margin-bottom: 10px;
    }

    .section-title {
      margin: 0;
      font-size: var(--type-section-title);
      line-height: 1.05;
      letter-spacing: -0.05em;
      overflow-wrap: anywhere;
    }

    .research-grid {
      display: grid;
      grid-template-columns: 0.95fr 1.05fr;
      gap: 18px;
      align-items: stretch;
    }

    .glass {
      position: relative;
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: var(--radius-xl);
      box-shadow: var(--shadow);
      overflow: hidden;
    }

    .about-card {
      padding: 28px;
    }

    .about-card p {
      position: relative;
      z-index: 1;
      color: var(--muted);
      font-size: var(--type-body);
      line-height: 1.7;
      margin: 0 0 18px;
      overflow-wrap: anywhere;
    }

    .about-card p:last-child { margin-bottom: 0; }
    .about-card strong { color: var(--text); }

    .orbital-card {
      min-height: 390px;
      display: grid;
      place-items: center;
      padding: 20px;
    }

    .orbit {
      position: relative;
      width: min(440px, 100%);
      aspect-ratio: 1;
      border-radius: 50%;
      display: grid;
      place-items: center;
      isolation: isolate;
      container-type: inline-size;
      --node-radius: 35cqw;
      --node-scale: 1;
    }

    .orbit::before,
    .orbit::after {
      content: "";
      position: absolute;
      inset: 12%;
      border: 1px dashed var(--orbit-line);
      border-radius: 50%;
      animation: rotate 28s linear infinite;
      pointer-events: none;
      z-index: -1;
    }

    .orbit::after {
      inset: 27%;
      animation-duration: 18s;
      animation-direction: reverse;
    }

    @keyframes rotate { to { transform: rotate(360deg); } }

    .core {
      z-index: 1;
      width: 34cqw;
      height: 34cqw;
      border-radius: 28%;
      display: grid;
      place-items: center;
      text-align: center;
      padding: 4cqw;
      font-weight: 900;
      letter-spacing: -0.045em;
      color: var(--on-accent);
      background: var(--accent);
      transform: rotate(-8deg);
      font-size: clamp(12px, 3.4cqw, 16px);
      line-height: 1.1;
    }

    .orbit-nodes {
      position: absolute;
      inset: 0;
      z-index: 1;
      pointer-events: none;
    }

    .node {
      position: absolute;
      left: 50%;
      top: 50%;
      display: grid;
      place-items: center;
      width: 27cqw;
      height: 24cqw;
      border-radius: 22%;
      text-align: center;
      padding: 2.5cqw;
      background: var(--card-strong);
      border: 1px solid var(--line);
      font-size: clamp(11px, 2.7cqw, 12px);
      line-height: 1.18;
      font-weight: 850;
      color: var(--text);
      box-shadow: var(--shadow);
      overflow-wrap: anywhere;
      pointer-events: auto;
      transform:
        translate(-50%, -50%)
        rotate(var(--node-angle, -90deg))
        translateX(var(--node-radius))
        rotate(var(--node-angle-inverse, 90deg))
        scale(var(--node-scale));
    }

    .papers-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .paper-card {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 16px;
      width: 100%;
      min-width: 0;
      min-height: auto;
      padding: 22px 24px;
      border-radius: var(--radius-lg);
      background: var(--card);
      border: 1px solid var(--line);
      overflow: hidden;
      transition: transform 0.22s ease, border-color 0.22s ease, background 0.22s ease;
    }

    .paper-card:hover {
      transform: translateY(-7px);
      border-color: var(--accent);
      background: var(--card-strong);
    }

    .paper-meta {
      position: relative;
      z-index: 1;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
    }

    .venue {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 8px 11px;
      border-radius: 999px;
      background: var(--accent-surface);
      color: var(--accent);
      border: 1px solid var(--accent-surface-strong);
      font-weight: 900;
      font-size: var(--type-label);
      line-height: 1.3;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .paper-year {
      color: var(--muted-2);
      font-family: "JetBrains Mono", monospace;
      font-size: var(--type-label);
      line-height: 1.3;
      font-weight: 800;
    }

    .paper-card h3 {
      position: relative;
      z-index: 1;
      margin: 0;
      font-size: var(--type-card-title);
      line-height: 1.28;
      letter-spacing: -0.035em;
      overflow-wrap: anywhere;
    }

    .paper-card p {
      position: relative;
      z-index: 1;
      color: var(--muted);
      font-size: var(--type-body);
      line-height: 1.6;
      margin: 0;
      overflow-wrap: anywhere;
    }

    .paper-card p.paper-highlight {
      margin-top: -7px;
      line-height: 1.5;
    }

    .paper-note {
      color: var(--muted-2);
      font-size: var(--type-meta);
      line-height: 1.5;
      margin: 14px 0 0;
    }

    .paper-links {
      position: relative;
      z-index: 1;
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: auto;
    }

    .mini-link {
      color: var(--text);
      text-decoration: none;
      font-size: var(--type-meta);
      line-height: 1.2;
      font-weight: 850;
      padding: 9px 11px;
      border-radius: 999px;
      border: 1px solid var(--line);
      background: var(--card);
      transition: 0.2s ease;
    }

    .mini-link:hover {
      border-color: rgba(255,255,255,0.35);
      background: var(--card-strong);
      transform: translateY(-2px);
    }

    .timeline {
      position: relative;
      display: grid;
      gap: 15px;
    }

    .timeline::before {
      content: "";
      position: absolute;
      left: 21px;
      top: 14px;
      bottom: 14px;
      width: 2px;
      background: var(--accent);
      opacity: 0.65;
    }

    .timeline-item {
      position: relative;
      min-width: 0;
      padding: 20px 20px 20px 62px;
      border-radius: 24px;
      background: var(--card);
      border: 1px solid var(--line);
      transition: transform .2s ease, border-color .2s ease;
    }

    .timeline-item:hover {
      transform: translateX(7px);
      border-color: var(--accent);
    }

    .timeline-dot {
      position: absolute;
      left: 12px;
      top: 24px;
      width: 20px;
      height: 20px;
      border-radius: 50%;
      background: var(--accent);
      border: 4px solid var(--bg-2);
      z-index: 2;
    }

    .timeline-item h3 {
      margin: 0 0 8px;
      font-size: var(--type-card-title);
      line-height: 1.28;
      letter-spacing: -0.035em;
      overflow-wrap: anywhere;
    }

    .timeline-item p {
      color: var(--muted);
      font-size: var(--type-body);
      margin: 0;
      line-height: 1.6;
    }

    .date {
      display: inline-block;
      margin-bottom: 10px;
      color: var(--accent);
      font-family: "JetBrains Mono", monospace;
      font-weight: 800;
      font-size: var(--type-meta);
      line-height: 1.3;
      overflow-wrap: anywhere;
    }

    .awards {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
    }

    .award {
      min-width: 0;
      padding: 18px;
      border-radius: 22px;
      border: 1px solid var(--line);
      background: var(--card);
      color: var(--muted);
      font-size: var(--type-secondary);
      line-height: 1.5;
      overflow-wrap: anywhere;
    }

    .award strong {
      display: block;
      color: var(--text);
      margin-bottom: 6px;
      font-size: var(--type-body);
      line-height: 1.4;
    }

    .blogs-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 360px), 1fr));
      gap: 14px;
    }

    .blog-card-shell {
      min-width: 0;
    }

    .blog-card {
      position: relative;
      isolation: isolate;
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 30px;
      height: 100%;
      min-width: 0;
      padding: clamp(22px, 3vw, 28px) clamp(24px, 4vw, 40px);
      overflow: hidden;
      border: 1px solid var(--line);
      border-radius: var(--radius-xl);
      background: var(--card);
      color: var(--text);
      text-decoration: none;
      box-shadow: var(--shadow);
      transition: transform .22s ease, border-color .22s ease, background .22s ease, box-shadow .22s ease;
    }

    .blog-card > * {
      position: relative;
      z-index: 1;
    }

    .blog-card-copy {
      min-width: 0;
    }

    .blog-card-date {
      display: inline-block;
      margin: 0 0 10px;
      color: var(--accent);
      font-family: "JetBrains Mono", monospace;
      font-size: var(--type-meta);
      line-height: 1.3;
      font-weight: 700;
      letter-spacing: 0.04em;
    }

    .blog-card h3 {
      max-width: 820px;
      margin: 0 0 14px;
      font-size: var(--type-card-title);
      line-height: 1.28;
      letter-spacing: -.035em;
      overflow-wrap: anywhere;
    }

    .blog-card p {
      max-width: 70ch;
      margin: 0;
      color: var(--muted);
      font-size: var(--type-body);
      line-height: 1.6;
      overflow-wrap: anywhere;
    }

    .blog-card-cta {
      display: inline-flex;
      align-self: center;
      min-height: 44px;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 11px 16px;
      border-radius: 999px;
      background: var(--accent);
      color: var(--on-accent);
      font-size: var(--type-meta);
      line-height: 1.2;
      font-weight: 900;
      white-space: nowrap;
    }

    .blog-card:focus-visible {
      outline: 3px solid var(--accent);
      outline-offset: 5px;
    }

    @media (hover: hover) {
      .blog-card:hover {
        transform: translateY(-7px);
        border-color: var(--accent);
        background: var(--card-strong);
      }
    }

    .footer {
      padding: 40px 0 36px;
      border-top: 1px solid var(--line);
      color: var(--muted);
    }

    .footer strong {
      font-size: var(--type-secondary);
      line-height: 1.5;
    }

    .footer-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
      flex-wrap: wrap;
    }

    .socials {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .socials a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 42px;
      padding: 0 15px;
      height: 42px;
      border-radius: 999px;
      border: 1px solid var(--line);
      background: var(--card);
      color: var(--text);
      text-decoration: none;
      font-size: var(--type-meta);
      font-weight: 900;
      line-height: 1.2;
      white-space: nowrap;
      transition: .2s ease;
    }

    .socials a:hover {
      transform: translateY(-3px) rotate(-4deg);
      border-color: var(--accent);
      background: var(--accent-surface);
    }

    @media (max-width: 940px) {
      .hero,
      .research-grid {
        grid-template-columns: 1fr;
      }
      .hero { padding-top: 56px; }
      .hero-card { max-width: 560px; justify-self: center; }
      .awards { grid-template-columns: repeat(2, 1fr); }
      .papers-grid { grid-template-columns: 1fr; }
      .section-head { align-items: start; flex-direction: column; }
    }

    @media (max-width: 680px) {
      .background-photo {
        inset: -14px;
        transform: scale(1.035);
        will-change: auto;
      }
      .background-photo img { object-position: 50% 46%; }
      .container { width: min(var(--max), calc(100% - 24px)); }
      .nav-wrap { top: 8px; margin-top: 8px; }
      nav { border-radius: 24px; gap: 10px; position: relative; }
      .nav-toggle { display: flex; }
      .nav-links {
        position: absolute;
        top: calc(100% + 10px);
        right: 0;
        flex-direction: column;
        align-items: stretch;
        gap: 4px;
        min-width: 190px;
        padding: 8px;
        border: 1px solid var(--line);
        border-radius: 20px;
        background: var(--menu-bg);
        box-shadow: var(--shadow);
        transform-origin: top right;
        transform: scale(0.92) translateY(-8px);
        opacity: 0;
        visibility: hidden;
        transition: transform 0.22s ease, opacity 0.22s ease, visibility 0.22s;
      }
      .nav-links.open {
        transform: scale(1) translateY(0);
        opacity: 1;
        visibility: visible;
      }
      .nav-links a {
        font-size: calc(var(--type-body) - 1px);
        padding: 11px 14px;
        border-radius: 14px;
      }
      h1 { letter-spacing: -0.07em; }
      .hero { padding: 42px 0 34px; }
      section { padding: 38px 0; }
      .footer { padding: 34px 0 30px; }
      .research-chips { inset: 18px 0 132px; }
      .research-chip { max-width: min(158px, 47%); min-height: 32px; padding: 7px 10px; font-size: 11px; }
      .status-card { left: 16px; right: 16px; bottom: 16px; }
      .awards { grid-template-columns: 1fr; }
      .orbital-card { min-height: 300px; padding: 22px; }
      .orbit { min-height: 0; }
      .timeline::before { left: 17px; }
      .timeline-item { padding-left: 52px; }
      .timeline-dot { left: 8px; }
      .blog-card {
        grid-template-columns: 1fr;
        align-items: start;
        gap: 22px;
        padding: 22px;
      }
      .blog-card-cta { justify-self: start; }
    }

    @media (prefers-reduced-motion: reduce) {
      .background-photo {
        transform: scale(1.035) !important;
        will-change: auto;
      }
      *, *::before, *::after {
        animation-duration: 0.001ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.001ms !important;
        scroll-behavior: auto !important;
      }
    }
  </style>
</head>
<body>
  <div class="background-photo" aria-hidden="true">
    <img
      id="backgroundPhotoImage"
      data-desktop-src="{{ profile.background_image | escape }}"
      data-mobile-src="{{ profile.background_image_mobile | escape }}"
      alt=""
      fetchpriority="high"
      decoding="async"
    >
  </div>
  <script>
    (function () {
      var image = document.getElementById('backgroundPhotoImage');
      var mobileBackground = window.matchMedia('(max-width: 680px)');
      var selectBackground = function () {
        var source = mobileBackground.matches ? image.dataset.mobileSrc : image.dataset.desktopSrc;
        if (image.getAttribute('src') !== source) image.setAttribute('src', source);
      };
      selectBackground();
      if (mobileBackground.addEventListener) mobileBackground.addEventListener('change', selectBackground);
    })();
  </script>
  <div class="background-veil" aria-hidden="true"></div>
  <div class="progress" id="progress"></div>
  <div class="container nav-wrap">
    <nav aria-label="Primary navigation">
      <a class="brand" href="#top" aria-label="{{ profile.name | escape }} homepage">
        <span class="brand-mark">{{ profile.initials | escape }}</span>
        <span>{{ profile.name | escape }}</span>
      </a>
      <div class="nav-links" id="navLinks">
        <a href="#about">About</a>
        <a href="#papers">Papers</a>
        <a href="#experience">Experience</a>
        <a href="#awards">Awards</a>
        <a href="#blogs">Blogs</a>
        <a href="#contact">Contact</a>
      </div>
      <div class="nav-actions">
        <button class="theme-toggle" id="themeToggle" type="button" aria-label="Toggle color theme">
          <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4.2"></circle>
            <path d="M12 2v2.4M12 19.6V22M4.9 4.9l1.7 1.7M17.4 17.4l1.7 1.7M2 12h2.4M19.6 12H22M4.9 19.1l1.7-1.7M17.4 6.6l1.7-1.7"></path>
          </svg>
          <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
          </svg>
        </button>
        <button class="nav-toggle" id="navToggle" aria-label="Open menu" aria-expanded="false" aria-controls="navLinks">
          <span class="nav-toggle-bar"></span>
          <span class="nav-toggle-bar"></span>
          <span class="nav-toggle-bar"></span>
        </button>
      </div>
    </nav>
  </div>

  <header class="hero container" id="top">
    <div class="hero-copy">
      <h1><span class="hero-name">{{ profile.name | escape }}</span><br>{{ profile.name_zh | escape }}</h1>
      <p class="hero-lead">
        {{ profile.hero_intro }}
      </p>
      <div class="cta-row">
        {% for link in profile.social_links %}
          {% if link.hero %}
            <a class="btn" href="{% if link.email %}mailto:{{ profile.email | escape }}{% else %}{{ link.url | escape }}{% endif %}"{% unless link.email %} target="_blank" rel="noreferrer"{% endunless %}>{{ link.label | escape }}</a>
          {% endif %}
        {% endfor %}
        <a class="btn primary" href="#papers">Explore papers <span aria-hidden="true">↘</span></a>
      </div>
    </div>

    <aside class="hero-card" aria-label="Profile card">
      <div class="portrait-wrap">
        <img src="{{ profile.image | escape }}" alt="{{ profile.name | escape }} portrait" fetchpriority="high" decoding="async" onerror="this.style.display='none'" />
        <div class="status-card">
          <h2>{{ profile.role | escape }}</h2>
          <p>{% for line in profile.affiliation %}{{ line | escape }}{% unless forloop.last %}<br>{% endunless %}{% endfor %}</p>
        </div>
      </div>
      {% if profile.research_chips.size > 0 %}
        <div class="research-chips" aria-label="Research interests">
          {% for chip in profile.research_chips %}
            <span class="research-chip">{{ chip | escape }}</span>
          {% endfor %}
        </div>
      {% endif %}
    </aside>
  </header>

  <main>
    <section id="about" class="container">
      <div class="section-head">
        <div>
          <div class="section-kicker">{{ profile.about.kicker | escape }}</div>
          <h2 class="section-title">{{ profile.about.heading | escape }}</h2>
        </div>
      </div>

      <div class="research-grid">
        <article class="glass about-card">
          {% for paragraph in profile.about.paragraphs %}
            <p>{{ paragraph }}</p>
          {% endfor %}
        </article>

        <article class="glass orbital-card" aria-label="Research map">
          <div class="orbit">
            <div class="core">{{ profile.about.map_core }}</div>
            {% if profile.about.map_nodes.size > 0 %}
              <div class="orbit-nodes">
                {% for node in profile.about.map_nodes %}
                  <div class="node">{{ node | escape }}</div>
                {% endfor %}
              </div>
            {% endif %}
          </div>
        </article>
      </div>
    </section>

    <section id="papers" class="container">
      <div class="section-head">
        <div>
          <div class="section-kicker">{{ papers.kicker | escape }}</div>
          <h2 class="section-title">{{ papers.heading | escape }}</h2>
        </div>
      </div>

      <div class="papers-grid">
        {% for paper in papers.items %}
        <article class="paper-card">
          <div class="paper-meta"><span class="venue">{{ paper.venue | escape }}</span><span class="paper-year">{{ paper.short_name | escape }}</span></div>
          <h3>{{ paper.title | escape }}</h3>
          <p>{{ paper.authors | escape }}</p>
          {% if paper.highlight %}<p class="paper-highlight"><strong>{{ paper.highlight | escape }}</strong></p>{% endif %}
          <div class="paper-links">
            {% for link in paper.links %}<a class="mini-link" href="{{ link.url | escape }}" target="_blank" rel="noreferrer">{{ link.label | escape }}</a>{% endfor %}
          </div>
        </article>
        {% endfor %}
      </div>
      <p class="paper-note">{{ papers.note | escape }}</p>
    </section>

    <section id="experience" class="container">
      <div class="section-head">
        <div>
          <div class="section-kicker">{{ experience.kicker | escape }}</div>
          <h2 class="section-title">{{ experience.heading | escape }}</h2>
        </div>
      </div>

      <div class="timeline">
        {% for item in experience.items %}
        <div class="timeline-item">
          <span class="timeline-dot"></span>
          <span class="date">{{ item.period | escape }}{% if item.location %} · {{ item.location | escape }}{% endif %}</span>
          <h3>{{ item.role | escape }}{% if item.team %}, {{ item.team | escape }}{% endif %} · {{ item.organization | escape }}</h3>
        </div>
        {% endfor %}
      </div>
    </section>

    <section id="awards" class="container">
      <div class="section-head">
        <div>
          <div class="section-kicker">{{ awards.kicker | escape }}</div>
          <h2 class="section-title">{{ awards.heading | escape }}</h2>
        </div>
      </div>

      <div class="awards">
        {% for award in awards.items %}
          <div class="award"><strong>{{ award.title | escape }}</strong>{% if award.organization %}{{ award.organization | escape }} · {% endif %}{{ award.year | escape }}</div>
        {% endfor %}
      </div>
    </section>

    <section id="blogs" class="container">
      <div class="section-head">
        <div>
          <div class="section-kicker">{{ blogs.kicker | escape }}</div>
          <h2 class="section-title">{{ blogs.heading | escape }}</h2>
        </div>
      </div>

      <div class="blogs-grid">
        {% for post in blogs.items %}
          <article class="blog-card-shell">
            <a
              class="blog-card"
              href="{{ post.url | escape }}"
              aria-labelledby="blog-title-{{ forloop.index }}"
              aria-describedby="blog-description-{{ forloop.index }}"
            >
              <div class="blog-card-copy">
                {% if post.date %}
                  <time class="blog-card-date" datetime="{{ post.date | escape }}">Published · {{ post.date | escape }}</time>
                {% endif %}
                <h3 id="blog-title-{{ forloop.index }}">{{ post.title | escape }}</h3>
                <p id="blog-description-{{ forloop.index }}">{{ post.description | escape }}</p>
              </div>
              <span class="blog-card-cta">{{ post.cta | escape }} <span aria-hidden="true">↗</span></span>
            </a>
          </article>
        {% endfor %}
      </div>
    </section>
  </main>

  <footer class="footer" id="contact">
    <div class="container footer-inner">
      <div>
        <strong>© {{ profile.footer_year | escape }} {{ profile.name | escape }} ({{ profile.name_zh | escape }})</strong>
      </div>
      <div class="socials" aria-label="Social links">
        {% for link in profile.social_links %}
          <a href="{% if link.email %}mailto:{{ profile.email | escape }}{% else %}{{ link.url | escape }}{% endif %}"{% unless link.email %} target="_blank" rel="noreferrer"{% endunless %} aria-label="{{ link.label | escape }}">{{ link.label | escape }}</a>
        {% endfor %}
      </div>
    </div>
  </footer>

  <script>
    // Keep research labels beside the portrait and research nodes around the core.
    const layoutResearchConstellations = () => {
      const chipContainer = document.querySelector('.research-chips');
      if (chipContainer) {
        const chips = [...chipContainer.querySelectorAll('.research-chip')];
        const leftChips = chips.filter((_, index) => index % 2 === 0);
        const rightChips = chips.filter((_, index) => index % 2 === 1);
        const densestSide = Math.max(leftChips.length, rightChips.length);

        const placeChipSide = (items, side) => {
          items.forEach((chip, row) => {
            chip.classList.add('chip-' + side);
            chip.style.setProperty('--chip-y', (((row + 1) / (items.length + 1)) * 100).toFixed(3) + '%');
          });
        };

        placeChipSide(leftChips, 'left');
        placeChipSide(rightChips, 'right');

        const maxChipHeight = Math.max(...chips.map((chip) => chip.offsetHeight));
        const verticalStep = chipContainer.clientHeight / (densestSide + 1);
        const densityScale = 1 - Math.max(0, densestSide - 3) * 0.075;
        const heightFitScale = maxChipHeight > 0 ? (verticalStep * 0.90) / maxChipHeight : 1;
        const chipScale = Math.max(0.46, Math.min(1, densityScale, heightFitScale));
        chipContainer.style.setProperty('--chip-scale', chipScale.toFixed(3));
      }

      document.querySelectorAll('.orbit-nodes').forEach((nodeContainer) => {
        const nodes = [...nodeContainer.querySelectorAll('.node')];
        const count = nodes.length;
        if (!count) return;

        const orbit = nodeContainer.closest('.orbit');
        const nodeScale = Math.max(0.48, 1 - Math.max(0, count - 4) * 0.055);
        const nodeRadius = count <= 4 ? 35 : count <= 8 ? 38 : count <= 12 ? 40 : 42;
        orbit.style.setProperty('--node-scale', nodeScale.toFixed(3));
        orbit.style.setProperty('--node-radius', nodeRadius + 'cqw');

        nodes.forEach((node, index) => {
          const angle = -90 + (360 * index / count);
          node.style.setProperty('--node-angle', angle.toFixed(3) + 'deg');
          node.style.setProperty('--node-angle-inverse', (-angle).toFixed(3) + 'deg');
        });
      });
    };

    layoutResearchConstellations();
    window.addEventListener('load', layoutResearchConstellations);
    window.addEventListener('resize', layoutResearchConstellations, { passive: true });

    // Subtle photo parallax for fine-pointer devices.
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const finePointer = window.matchMedia('(pointer: fine)');

    if (finePointer.matches && !reducedMotion.matches) {
      const rootStyle = document.documentElement.style;
      let currentX = 0.5;
      let currentY = 0.34;
      let targetX = currentX;
      let targetY = currentY;
      let backgroundFrame = null;

      const renderBackgroundMotion = () => {
        currentX += (targetX - currentX) * 0.075;
        currentY += (targetY - currentY) * 0.075;

        rootStyle.setProperty('--bg-shift-x', ((currentX - 0.5) * -18).toFixed(2) + 'px');
        rootStyle.setProperty('--bg-shift-y', ((currentY - 0.5) * -12).toFixed(2) + 'px');

        const distance = Math.abs(targetX - currentX) + Math.abs(targetY - currentY);
        if (distance > 0.0005) {
          backgroundFrame = requestAnimationFrame(renderBackgroundMotion);
        } else {
          backgroundFrame = null;
        }
      };

      const requestBackgroundFrame = () => {
        if (backgroundFrame === null) {
          backgroundFrame = requestAnimationFrame(renderBackgroundMotion);
        }
      };

      window.addEventListener('pointermove', (event) => {
        targetX = Math.min(1, Math.max(0, event.clientX / window.innerWidth));
        targetY = Math.min(1, Math.max(0, event.clientY / window.innerHeight));
        requestBackgroundFrame();
      }, { passive: true });

      const resetBackgroundMotion = () => {
        targetX = 0.5;
        targetY = 0.34;
        requestBackgroundFrame();
      };

      document.addEventListener('mouseleave', resetBackgroundMotion);
      window.addEventListener('blur', resetBackgroundMotion);
    }

    // Theme toggle with persistence.
    const themeToggle = document.getElementById('themeToggle');
    themeToggle.addEventListener('click', () => {
      const next = document.documentElement.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', next);
      try { localStorage.setItem('theme', next); } catch (e) {}
    });

    const progress = document.getElementById('progress');
    const updateProgress = () => {
      const total = document.documentElement.scrollHeight - window.innerHeight;
      const pct = total > 0 ? (window.scrollY / total) * 100 : 0;
      progress.style.width = pct + '%';
    };
    updateProgress();
    window.addEventListener('scroll', updateProgress, { passive: true });

    // Mobile nav toggle.
    const navToggle = document.getElementById('navToggle');
    const navLinks = document.getElementById('navLinks');
    const setNav = (open) => {
      navLinks.classList.toggle('open', open);
      navToggle.setAttribute('aria-expanded', String(open));
      navToggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    };
    navToggle.addEventListener('click', (e) => {
      e.stopPropagation();
      setNav(!navLinks.classList.contains('open'));
    });
    navLinks.addEventListener('click', (e) => {
      if (e.target.closest('a')) setNav(false);
    });
    document.addEventListener('click', (e) => {
      if (navLinks.classList.contains('open') && !e.target.closest('nav')) setNav(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setNav(false);
    });

    // Scroll-spy: highlight the nav link for the section currently in view.
    const navAnchors = [...navLinks.querySelectorAll('a')];
    const sectionFor = (a) => {
      const href = a.getAttribute('href') || '';
      return href.startsWith('#') ? document.querySelector(href) : null;
    };
    const spy = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const id = entry.target.id;
        navAnchors.forEach((a) => {
          a.classList.toggle('active', a.getAttribute('href') === '#' + id);
        });
      });
    }, { rootMargin: '-45% 0px -50% 0px' });

    navAnchors.map(sectionFor).filter(Boolean).forEach((sec) => spy.observe(sec));

  </script>
</body>
</html>
